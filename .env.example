# AI Configuration
# Option 1: Use Gemini (requires API key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Use Llama through Ollama (local AI model)
USE_OLLAMA=true
OLLAMA_MODEL=llama3.2

# Default AI backend preference (auto, llama, gemini)
PREFERRED_BACKEND=auto

# Server Configuration
PORT=3000
